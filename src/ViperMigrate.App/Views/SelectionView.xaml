<UserControl x:Class="ViperMigrate.App.Views.SelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ViperMigrate.App.ViewModels">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Review &amp; Select Items"
                       Style="{StaticResource Heading}" />
            <TextBlock Text="Deselect items you don't want to restore"
                       Style="{StaticResource SubHeading}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Search -->
        <TextBox Grid.Row="1"
                 Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource TextInput}"
                 Margin="0,0,0,12">
            <TextBox.Tag>Search items...</TextBox.Tag>
        </TextBox>

        <!-- Sections -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,16">
            <StackPanel>

                <!-- Software - Auto Install (winget) -->
                <Expander IsExpanded="True"
                          Visibility="{Binding WingetSoftwareItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Auto Install / winget (" /><Run Text="{Binding WingetSoftwareItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllWingetSoftwareCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllWingetSoftwareCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WingetSoftwareItems}"
                                      VirtualizingStackPanel.IsVirtualizing="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Software - Manual Install -->
                <Expander IsExpanded="False"
                          Visibility="{Binding ManualSoftwareItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Manual Install (" /><Run Text="{Binding ManualSoftwareItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllManualSoftwareCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllManualSoftwareCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ManualSoftwareItems}"
                                      VirtualizingStackPanel.IsVirtualizing="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Printers Section -->
                <Expander IsExpanded="True"
                          Visibility="{Binding PrinterItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Printers (" /><Run Text="{Binding PrinterItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllPrintersCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllPrintersCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PrinterItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Scanners Section -->
                <Expander IsExpanded="True"
                          Visibility="{Binding ScannerItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Scanners (" /><Run Text="{Binding ScannerItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllScannersCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllScannersCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ScannerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Mapped Drives Section -->
                <Expander IsExpanded="True"
                          Visibility="{Binding DriveItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Mapped Drives (" /><Run Text="{Binding DriveItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllDrivesCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllDrivesCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DriveItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" → " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Browsers Section -->
                <Expander IsExpanded="True"
                          Visibility="{Binding BrowserItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Browsers (" /><Run Text="{Binding BrowserItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllBrowsersCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllBrowsersCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding BrowserItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- WiFi Section -->
                <Expander IsExpanded="True"
                          Visibility="{Binding WiFiItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="WiFi (" /><Run Text="{Binding WiFiItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllWiFiCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllWiFiCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WiFiItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Shortcuts Section -->
                <Expander IsExpanded="False"
                          Visibility="{Binding ShortcutItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Shortcuts (" /><Run Text="{Binding ShortcutItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllShortcutsCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllShortcutsCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ShortcutItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Outlook Configuration -->
                <Border Visibility="{Binding HasOutlookConfig, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,8" Padding="4,6">
                    <CheckBox IsChecked="{Binding IncludeOutlook}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Outlook Configuration"
                                       Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                            <TextBlock Text="{Binding OutlookDetail}"
                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Office Recent Files Section -->
                <Expander IsExpanded="False"
                          Visibility="{Binding OfficeRecentItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="Office Recent Files (" /><Run Text="{Binding OfficeRecentItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllOfficeRecentCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllOfficeRecentCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OfficeRecentItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- App Settings Section -->
                <Expander IsExpanded="True"
                          Visibility="{Binding AppSettingItems.Count, Converter={StaticResource CountToVisibility}}"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold">
                            <Run Text="App Settings (" /><Run Text="{Binding AppSettingItems.Count, Mode=OneWay}" /><Run Text=" items)" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Select All" Style="{StaticResource LinkButton}"
                                    Command="{Binding SelectAllAppSettingsCommand}" Margin="0,0,12,0" />
                            <Button Content="Deselect All" Style="{StaticResource LinkButton}"
                                    Command="{Binding DeselectAllAppSettingsCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding AppSettingItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SubtextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Bar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSummary}"
                       Foreground="{StaticResource SubtextBrush}"
                       VerticalAlignment="Center"
                       FontSize="13" />

            <Button Grid.Column="1"
                    Content="Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    Margin="0,0,12,0" />

            <Button Grid.Column="2"
                    Content="Start Restore"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartRestoreCommand}" />
        </Grid>
    </Grid>
</UserControl>
