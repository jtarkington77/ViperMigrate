<UserControl x:Class="ViperMigrate.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ViperMigrate.App.ViewModels">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Capture Workstation"
                       Style="{StaticResource Heading}" />
            <TextBlock Text="Select the categories to capture and choose a destination"
                       Style="{StaticResource SubHeading}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Categories -->
                <TextBlock Text="Categories"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource SubtextBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Destination -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}"
                            Padding="16,6" />
                </Grid>

                <!-- Password -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Password (optional)" Foreground="{StaticResource SubtextBrush}"
                                   Margin="0,0,0,4" FontSize="12" />
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirm Password" Foreground="{StaticResource SubtextBrush}"
                                   Margin="0,0,0,4" FontSize="12" />
                        <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions (always visible) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    Margin="0,0,12,0" />
            <Button Content="Start Capture"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartCaptureCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
