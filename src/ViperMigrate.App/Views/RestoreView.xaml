<UserControl x:Class="ViperMigrate.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Restore Workstation"
                       Style="{StaticResource Heading}" />
            <TextBlock Text="Load a migration package to restore settings"
                       Style="{StaticResource SubHeading}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Package Path -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}"
                            Padding="16,6"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Load"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadPackageCommand}"
                            Padding="16,6" />
                </Grid>

                <!-- Password -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Package Password (if encrypted)" Foreground="{StaticResource SubtextBrush}"
                               Margin="0,0,0,4" FontSize="12" />
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                 MaxWidth="300" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Category Selection (shown after load) -->
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,16"
                              Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" - " Foreground="{StaticResource SubtextBrush}" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource SubtextBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Package Info -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6" Padding="16"
                        Visibility="{Binding PackageInfo, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding PackageInfo}"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions (always visible) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    Margin="0,0,12,0" />
            <Button Content="Start Restore"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartRestoreCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
