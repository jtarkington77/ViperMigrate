<Window x:Class="ViperMigrate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ViperMigrate.App.ViewModels"
        Icon="/Assets/ViperMigrate.ico"
        Title="ViperMigrate"
        Height="850" Width="1100"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- Home screen (visible when no view is selected) -->
        <Grid x:Name="HomePanel"
              Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibleConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Logo Image -->
                <Image Source="/Assets/ViperMigrate.png"
                       Width="200" Height="200"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,0,16" />

                <TextBlock Text="VIPERMIGRATE"
                           Style="{StaticResource Heading}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <TextBlock Text="Workstation Migration Tool"
                           Style="{StaticResource SubHeading}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Capture"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateToCaptureCommand}"
                            Width="180" Height="50"
                            Margin="0,0,16,0" />
                    <Button Content="Restore"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding NavigateToRestoreCommand}"
                            Width="180" Height="50" />
                </StackPanel>

                <TextBlock Text="Capture your workstation settings or restore from a migration package"
                           Style="{StaticResource SubHeading}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0" />
            </StackPanel>
        </Grid>

        <!-- View content area -->
        <ContentControl Content="{Binding CurrentView}"
                        Visibility="{Binding CurrentView, Converter={StaticResource NotNullToVisibleConverter}}" />
    </Grid>
</Window>
